{
  "name": "panificio-de-conca",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Sito vetrina del Panificio De Conca, Gaeta (IT/EN/DE)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/verify-dist.mjs",
    "preview": "astro preview",
    "check": "astro check && eslint . && prettier --check . && node scripts/check-tokens.mjs",
    "format": "prettier --write .",
    "test": "node --test 'tests/**/*.test.mjs' && node scripts/verify-dist.mjs",
    "shots": "node scripts/shots.mjs",
    "compare": "node scripts/compare.mjs",
    "font:subset": "node scripts/subset-font.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "~3.7.0",
    "astro": "^5.18.2",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^16.0.0",
    "playwright": "~1.63.0",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.1",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
