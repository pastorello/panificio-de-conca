// Cloudflare Workers with static assets only (CLAUDE.md, Pubblicazione).
// Workers Builds runs `npm run build` and then `npx wrangler deploy`, which reads this file.
// SITE_URL and SITE_PHASE are build variables set in the Cloudflare dashboard, not here.
{
  "name": "panificio-de-conca",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash",
  },
}
