---
// Note legali e privacy (BRIEF.md §8.10, DESIGN.md §5.4): H1 and text, no photo, no VisitBlock.
// The CTA row under the H1 shows only from 1024 px, where the fixed bar is gone (DESIGN.md §3
// principle 1, design/HANDOFF.md §5). Company data come from business.json, the labels and the
// privacy notice from the content files.
import type { Locale } from '../routes';
import { displayPhone, getPage, telHref, type Business, type Strings } from '../lib/site';
import CtaBar from '../components/CtaBar.astro';
import Section from '../components/Section.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  t: Strings;
  business: Business;
}

const { locale, t, business } = Astro.props;
const page = await getPage('legal', locale);
const { company, privacy } = page;
const { address } = business;
---

<section class="dc-col dc-intro">
  <h1 class="dc-h1"><Text value={page.title} /></h1>
  <CtaBar t={t} business={business} variant="row" intro />
  <dl class="dc-dl">
    <dt>{company.name}</dt>
    <dd>{business.legalName}</dd>
    <dt>{company.office}</dt>
    <dd>
      {address.street}
      <Text value={address.number} />, {address.postalCode}
      {address.locality} ({address.region})
    </dd>
    <dt>{company.vat}</dt>
    <dd>{business.vatId}</dd>
    <dt>{company.rea}</dt>
    <dd>{business.rea}</dd>
    <dt>{company.phone}</dt>
    <dd><a class="dc-target" href={telHref(business)}>{displayPhone(business, locale)}</a></dd>
    <dt>{company.email}</dt>
    <dd><Text value={business.pec} /></dd>
  </dl>
</section>

<Section title={privacy.title} text={privacy.text} />
