---
// Dove siamo (BRIEF.md §8.8, DESIGN.md §5.7): photo, OpenNow, address and the two map links, then
// the four ways of arriving with their icons, then photo 24. No embedded map. Below 1024 px the
// photo comes right after the H1 (mockup mobile-dove-siamo); from 1024 px OpenNow and the CTA row
// come first and the photo, address and links follow (mockup desktop-dove-siamo).
import type { Locale } from '../routes';
import { getPage, type Business, type Strings } from '../lib/site';
import CtaBar from '../components/CtaBar.astro';
import Directions from '../components/Directions.astro';
import Figure from '../components/Figure.astro';
import MapLinks from '../components/MapLinks.astro';
import OpenNow from '../components/OpenNow.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  t: Strings;
  business: Business;
}

const { locale, t, business } = Astro.props;
const page = await getPage('findus', locale);
const { photo, view } = page;
---

<section class="dc-col dc-intro">
  <h1 class="dc-h1"><Text value={page.title} /></h1>
  <div class="dc-intro__media later">
    <Figure
      ratio="3x2"
      image={photo.image}
      alt={photo.alt}
      placeholder={photo.placeholder}
      caption={photo.caption}
      sizes="(min-width: 760px) 720px, calc(100vw - 40px)"
      widths={[480, 720, 780]}
      priority
    />
  </div>
  <OpenNow locale={locale} t={t} business={business} />
  <CtaBar t={t} business={business} variant="row" intro />
  <p class="later"><Text value={page.address} /></p>
  <div class="later">
    <MapLinks business={business} t={t} variant="pair" />
  </div>
</section>

<div class="dc-col modes">
  <Directions modes={page.modes} />
</div>

<div class="dc-col">
  <Figure
    ratio="3x2"
    image={view.image}
    alt={view.alt}
    placeholder={view.placeholder}
    caption={view.caption}
    sizes="(min-width: 760px) 720px, calc(100vw - 40px)"
  />
</div>

<style>
  .modes {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }
  @media (min-width: 1024px) {
    .later {
      order: 1;
    }
  }
</style>
