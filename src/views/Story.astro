---
// La storia (BRIEF.md §8.4, DESIGN.md §5.6): the timeline with the period photos in the 720 px
// column (years on the left from 1024 px), then the sources box: without it the site does not
// quote «il più antico della provincia». The VisitBlock closes the page.
import { getEntry } from 'astro:content';
import type { Locale } from '../routes';
import type { Business, Strings } from '../lib/site';
import CtaBar from '../components/CtaBar.astro';
import SourcesBox from '../components/SourcesBox.astro';
import StoryTimeline from '../components/StoryTimeline.astro';
import Text from '../components/Text.astro';
import TimelineItem from '../components/TimelineItem.astro';

interface Props {
  locale: Locale;
  t: Strings;
  business: Business;
}

const { locale, t, business } = Astro.props;
const entry = await getEntry('story', locale);
if (!entry) throw new Error(`Missing src/content/story/${locale}.md`);
const story = entry.data;
---

<section class="dc-col dc-intro intro">
  <h1 class="dc-h1"><Text value={story.title} /></h1>
  <p><Text value={story.subtitle} /></p>
  <CtaBar t={t} business={business} variant="row" intro />
</section>

<div class="dc-col">
  <StoryTimeline>
    {
      story.items.map((item) => (
        <TimelineItem
          year={item.year}
          text={item.text}
          figure={
            item.image || item.placeholder
              ? {
                  image: item.image,
                  alt: item.alt,
                  placeholder: item.placeholder,
                  caption: item.caption,
                  vintage: item.vintage,
                }
              : undefined
          }
        />
      ))
    }
  </StoryTimeline>
</div>

<div class="dc-col">
  <SourcesBox label={story.sources.label} items={story.sources.items} />
</div>

<style>
  /* Mockup mobile-storia: 12 px between H1 and subtitle. */
  .intro {
    gap: var(--space-3);
  }
  @media (min-width: 1024px) {
    .intro {
      gap: var(--gap-intro);
    }
  }
</style>
