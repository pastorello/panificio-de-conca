---
// Ordini e forniture (BRIEF.md §8.7, DESIGN.md §5.4): the content-page template without a photo;
// the big phone number takes its place. The first section, the booking rule, is an OrderRule with
// the call button; the holiday price list is a secondary button, a placeholder until the file exists.
// No desktop mockup: the 720 px column of desktop-tiella (design/HANDOFF.md §3).
import type { Locale } from '../routes';
import { getPage, telLink, type Business, type Strings } from '../lib/site';
import { hasPlaceholder } from '../lib/text';
import CtaBar from '../components/CtaBar.astro';
import OrderRule from '../components/OrderRule.astro';
import PhoneNumber from '../components/PhoneNumber.astro';
import Section from '../components/Section.astro';
import Text from '../components/Text.astro';

interface Props {
  locale: Locale;
  t: Strings;
  business: Business;
}

const { locale, t, business } = Astro.props;
const page = await getPage('orders', locale);
const { fresh, what, holidays, shipping } = page;
const { priceList } = holidays;
---

<section class="dc-col dc-intro">
  <h1 class="dc-h1"><Text value={page.title} /></h1>
  <p><Text value={page.subtitle} tel={telLink(business)} /></p>
  <CtaBar t={t} business={business} variant="row" intro />
  <div class="dc-intro__media">
    <PhoneNumber locale={locale} business={business} />
  </div>
</section>

<div class="dc-col">
  <OrderRule business={business} title={fresh.title} text={fresh.text} call={t.cta.call} />
</div>

<Section title={what.title} text={what.text} />

<Section title={holidays.title} text={holidays.text}>
  <div class="dc-actions">
    {
      hasPlaceholder(priceList.href) ? (
        <span class="dc-btn dc-btn--secondary">
          <Text value={priceList.label} />
        </span>
      ) : (
        <a class="dc-btn dc-btn--secondary" href={priceList.href}>
          <Text value={priceList.label} />
        </a>
      )
    }
  </div>
</Section>

<Section title={page.business.title} text={page.business.text} />

<Section title={page.boats.title} text={page.boats.text} />

<Section title={shipping.title} text={shipping.text} />
