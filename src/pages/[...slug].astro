---
// Every page in every language, from the slug map in src/routes.ts. The copy of each page
// lives in src/content/ and its template in src/views/.
import BaseLayout from '../layouts/BaseLayout.astro';
import { staticPaths, type Locale, type RouteKey } from '../routes';
import { getBusiness, getStrings } from '../lib/site';
import { bakeryJsonLd } from '../lib/jsonld';
import Home from '../views/Home.astro';
import Tiella from '../views/Tiella.astro';
import Products from '../views/Products.astro';
import Story from '../views/Story.astro';
import Orders from '../views/Orders.astro';
import FindUs from '../views/FindUs.astro';
import Contact from '../views/Contact.astro';
import Legal from '../views/Legal.astro';

export function getStaticPaths() {
  return staticPaths();
}

interface Props {
  routeKey: RouteKey;
  locale: Locale;
}

const { routeKey, locale } = Astro.props;
const t = await getStrings(locale);
const business = await getBusiness();
const site = Astro.site ?? new URL('http://localhost:4321');
const meta = t.meta[routeKey];
const withJsonLd = routeKey === 'home' || routeKey === 'findus';
// Contatti already is hours and address: no VisitBlock there, as in DESIGN.md §5.8 and the mockup.
const visit = routeKey !== 'legal' && routeKey !== 'contact';
const view = { locale, t, business };
---

<BaseLayout
  locale={locale}
  routeKey={routeKey}
  title={meta.title}
  description={meta.description}
  visit={visit}
  jsonLd={withJsonLd ? bakeryJsonLd(business, site) : undefined}
>
  {routeKey === 'home' && <Home {...view} />}
  {routeKey === 'tiella' && <Tiella {...view} />}
  {routeKey === 'products' && <Products {...view} />}
  {routeKey === 'story' && <Story {...view} />}
  {routeKey === 'orders' && <Orders {...view} />}
  {routeKey === 'findus' && <FindUs {...view} />}
  {routeKey === 'contact' && <Contact {...view} />}
  {routeKey === 'legal' && <Legal {...view} />}
</BaseLayout>
