---
// A photo with its caption (DESIGN.md §6.5): fixed ratio, square corners, never text on top.
// AVIF/WebP with srcset via astro:assets; the first photo of a page has fetchpriority="high",
// the others load lazily. Period photos are already black and white in the file (no filter).
// Without the final photo: a paper-deep box with the number of the brief's photo list (§9),
// written as a [[placeholder]] so that a live build cannot ship it.
// `desktop` swaps in another crop from 1024 px (the Home hero: 3:2 on phones, 4:3 beside the H1):
// one <picture> with media sources, so each screen downloads only its own file.
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';
import Text from './Text.astro';

type Ratio = '3x2' | '4x3' | '4x5';

interface Props {
  ratio: Ratio;
  image?: ImageMetadata;
  /** Written in the language of the page, from the content files. */
  alt?: string;
  /** «Foto 24 — vista del lungomare con la base sullo sfondo», when the photo is missing. */
  placeholder?: string;
  caption?: string;
  vintage?: boolean;
  priority?: boolean;
  /** Rendered width of the figure, for srcset. */
  sizes?: string;
  widths?: number[];
  desktop?: { image: ImageMetadata; ratio: Ratio; sizes: string; widths: number[] };
}

const {
  ratio,
  image,
  alt = '',
  placeholder,
  caption,
  vintage = false,
  priority = false,
  sizes = '(min-width: 1024px) 720px, 100vw',
  widths = [480, 720, 960, 1280],
  desktop,
} = Astro.props;
if (!image && !placeholder) throw new Error('Figure needs an image or a placeholder');

const formats = ['avif', 'webp'] as const;
const fit = (list: number[], source: ImageMetadata) => {
  const kept = list.filter((width) => width <= source.width);
  return kept.length ? kept : [source.width];
};
const sources =
  image && desktop
    ? await Promise.all(
        [
          { media: '(min-width: 1024px)', ...desktop },
          { media: undefined, image, sizes, widths },
        ].flatMap((set) =>
          formats.map(async (format) => {
            const result = await getImage({
              src: set.image,
              widths: fit(set.widths, set.image),
              format,
            });
            return {
              media: set.media,
              type: `image/${format}`,
              srcset: result.srcSet.attribute,
              sizes: set.sizes,
              width: set.image.width,
              height: set.image.height,
            };
          }),
        ),
      )
    : [];
const fallback = image && desktop ? await getImage({ src: image, format: 'jpg' }) : undefined;
---

<figure
  class:list={[
    'dc-figure',
    `dc-figure--${ratio}`,
    desktop && `dc-figure--desktop-${desktop.ratio}`,
    { 'dc-figure--vintage': vintage },
  ]}
>
  {
    image && fallback ? (
      <picture>
        {sources.map((source) => (
          <source {...source} />
        ))}
        <img
          src={fallback.src}
          alt={alt}
          width={image.width}
          height={image.height}
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
        />
      </picture>
    ) : image ? (
      <Picture
        src={image}
        alt={alt}
        formats={[...formats]}
        widths={fit(widths, image)}
        sizes={sizes}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
      />
    ) : (
      <div class="dc-figure__placeholder">
        <Text value={`[[${placeholder}]]`} />
      </div>
    )
  }
  {
    caption && (
      <figcaption>
        <Text value={caption} />
      </figcaption>
    )
  }
</figure>
